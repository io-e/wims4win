# GROK_V1_1 P4 WIMS patch (cumulative: replaces p4_json_GROK_V1.diff). Apply in public_html: patch -p1 < p4_wims_GROK_V1_1.diff
# - special_parm=p4_json stripped grading hook (never emits the expected answer), as in V1;
# - V1_1: adm/raw job=p4render = lightpopup copy that requires the P4 shared secret (POST field p4_auth), OEF modules only, marks the session wims_p4_auth=yes;
# - V1_1: the p4_json hook answers only in sessions marked by p4render, otherwise {"p4":1,"error":"auth"};
# - V1_1: scripts/p4/p4_auth.proc reads the secret from wimshome/log/p4_auth/p4_secret.proc (written by harden_wims_p4_GROK_V1_1.py) and compares every character.
# lightpopup and every other WIMS page are unchanged. GPL-2 like WIMS. Written by Grok Bot.
diff -ruN a/modules/adm/raw/jobs/p4render.proc b/modules/adm/raw/jobs/p4render.proc
--- a/modules/adm/raw/jobs/p4render.proc	1970-01-01 01:00:00.000000000 +0100
+++ b/modules/adm/raw/jobs/p4render.proc	2026-11-23 12:14:40.381399262 +0100
@@ -0,0 +1,24 @@
+# GROK_V1_1 P4: authenticated copy of lightpopup for the P4 OEF worker (lightpopup itself is unchanged, it is
+# used by WIMS's own "about"/embed pages). Requires the P4 shared secret in the POST field p4_auth.
+# Marks the session wims_p4_auth=yes (the p4_json hook answers only then).
+# Only OEF exercise modules (emod with a def/ folder, not adm/) are opened.
+!read defs
+ident_type=json
+code=p4
+!read p4/p4_auth.proc
+!if $p4_auth_ok!=yes
+ !changeto error.proc p4_auth_refused
+!endif
+!if adm/ isin $emod or .. isin $emod or $emod=$empty
+ !changeto error.proc p4_bad_module
+!endif
+option=noabout
+!setdef wims_lightpopup=yes in wimshome/sessions/$wims_session/var.stat
+!setdef w_wims_lightpopup=yes in wimshome/sessions/$wims_session/var
+!setdef wims_lightpopup_option=$option in wimshome/sessions/$wims_session/var.stat
+!setdef w_wims_lightpopup_option=$option in wimshome/sessions/$wims_session/var
+!! session binding: the p4_json hook of scripts/oef only answers in sessions marked here
+!setdef wims_p4_auth=yes in wimshome/sessions/$wims_session/var.stat
+!setdef wims_protocol=$wims_protocol in wimshome/sessions/$wims_session/var.stat
+parm=!replace internal ; by & in $parm
+!restart session=$wims_session&module=$emod&$parm
