tmp0=!replace internal ? by &#63; in 1,2,4,5,6,7	1,2,7,8	1,4,5	1,2,6,7,8,10	2,3,5	1,2,3,5,6,7

tmp=!trim $(tmp0)	
val11=!translate internal $	\
$ to ;; in $tmp
